<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NovaTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">#070B14</item>
        <item name="android:statusBarColor">#070B14</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Android 15+ only: keep system navigation outside Nova's own fixed bottom nav. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
