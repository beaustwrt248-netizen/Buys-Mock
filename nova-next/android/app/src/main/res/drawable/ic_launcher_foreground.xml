<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="18dp"
        android:top="18dp"
        android:right="18dp"
        android:bottom="18dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.35"
                android:centerY="0.30"
                android:gradientRadius="48dp"
                android:startColor="@color/nova_icon_highlight"
                android:centerColor="@color/nova_icon_blue"
                android:endColor="@color/nova_icon_violet" />
            <stroke android:width="1dp" android:color="#806BD2FF" />
        </shape>
    </item>
</layer-list>
